# Adres lokalnego lub zdalnego serwera Ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Pozostaw puste dla lokalnej instancji bez uwierzytelniania.
OLLAMA_TOKEN=

# Wyłączaj tylko dla zaufanego serwera z certyfikatem self-signed.
VERIFY_SSL=true

# Opcjonalna lokalizacja danych projektów i zapasowa lista modeli dla UI.
CODEFABRIC_DATA_DIR=./chats
CODEFABRIC_MODELS=qwen2.5-coder:7b

# Model dotyczy diagnostyki; timeout obowiązuje też agentów aplikacji.
MODEL_CODER=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120
